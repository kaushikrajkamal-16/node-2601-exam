---
title: "DFD Level 1 - Major processes and data stores: JobPortal BD"
---
flowchart TB
    V["Visitor"]
    A["Applicant"]
    C["Company (Recruiter)"]
    AD["Admin"]
    MAIL["Gmail SMTP"]
    CLD["Cloudinary"]

    P1(("1.0<br/>Register and<br/>authenticate"))
    P2(("2.0<br/>Manage own<br/>profile"))
    P3(("3.0<br/>Browse public<br/>jobs and companies"))
    P4(("4.0<br/>Apply and track<br/>applications"))
    P5(("5.0<br/>Manage job posts"))
    P6(("6.0<br/>Review candidates"))
    P7(("7.0<br/>Administer<br/>platform"))

    D1[("D1 Users<br/>MongoDB users")]
    D2[("D2 Jobs<br/>MongoDB jobs")]
    D3[("D3 Applications<br/>MongoDB applications")]

    V -- "registration data, credentials, OTP,<br/>reset request and new password" --> P1
    P1 -- "login result, session cookie, verification messages" --> V
    P1 -- "OTP e-mail" --> MAIL
    P1 <-- "user record, OTP and expiry, password hash" --> D1

    A -- "profile data, photo" --> P2
    C -- "company profile, logo" --> P2
    P2 -- "updated profile" --> A
    P2 -- "updated profile" --> C
    P2 <-- "profile fields, photo reference" --> D1
    P2 -- "photo or logo, delete old file" --> CLD
    CLD -- "photo URL and public id" --> P2

    V -- "list, latest, detail and company queries" --> P3
    P3 -- "job cards, job details, company list" --> V
    P3 <-- "job records" --> D2
    P3 <-- "company profile fields" --> D1

    A -- "resume file, job selection, withdraw request" --> P4
    P4 -- "application list with status, confirmation" --> A
    P4 <-- "job status and deadline" --> D2
    P4 <-- "application records" --> D3
    P4 -- "resume file, delete request" --> CLD
    CLD -- "resume URL and public id" --> P4

    C -- "job data, edit, pause, delete" --> P5
    P5 -- "own jobs with applicant and hired counts" --> C
    P5 <-- "job records" --> D2
    P5 -- "delete applications of a deleted job" --> D3
    P5 -- "delete resume files" --> CLD

    C -- "candidate filter, new status, interview note, remove" --> P6
    P6 -- "candidate list with resume links" --> C
    P6 <-- "application records and status history" --> D3
    P6 -- "applicant summary lookup" --> D1
    P6 -- "delete resume file" --> CLD

    AD -- "add, flag, close, delete commands, list filters" --> P7
    P7 -- "statistics and lists" --> AD
    P7 <-- "all user records" --> D1
    P7 <-- "all job records" --> D2
    P7 <-- "all application records" --> D3
    P7 -- "delete photos and resumes" --> CLD

    classDef proc fill:#eef4ff,stroke:#2563eb,color:#0b1c30;
    classDef store fill:#f0fdf4,stroke:#15803d,color:#0b1c30;
    classDef ext fill:#fff7ed,stroke:#c2410c,color:#0b1c30;
    class P1,P2,P3,P4,P5,P6,P7 proc;
    class D1,D2,D3 store;
    class V,A,C,AD,MAIL,CLD ext;
