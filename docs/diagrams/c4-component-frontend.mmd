C4Component
    title Component Diagram - Single-Page Application container (frontend, C4 level 3)

    Container(api, "REST API", "Express", "/api/v1")
    Person(user, "Browser user", "Visitor, Applicant, Company, Admin")

    Container_Boundary(spa, "Single-Page Application (Client/src)") {
        Component(app, "App.jsx + main.jsx", "React Router, Redux Provider", "Route table, store provider")
        Component(layouts, "Rootlayout", "MainLayout, DashboardLayout", "Navbar+Footer or Sidebar shells")
        Component(guard, "ProtectedRoute", "Route guard", "useGetMeQuery; redirect to /login or own dashboard")
        Component(pub, "Public pages", "Home, Jobs, JobsDetails, Companies, About, Contact", "Browse and apply entry point")
        Component(authp, "Auth pages", "Login, Registration, VerifyOtp, ForgotPassword, ResetPassword", "Account access and recovery")
        Component(appd, "Applicant dashboard", "ApplicantDashboard, ApplicantApplication", "Own applications")
        Component(recd, "Recruiter dashboard", "RecruiterDashboard (886 lines)", "Jobs and candidates")
        Component(admd, "Admin dashboard", "AdminDashboard, ManageApplicants, ManageCompanies, ManageJobPosts", "Moderation")
        Component(modals, "Modals", "ApplyModal, PostJobModal, EditProfileModal, AddApplicantModal, AddCompanyModal", "Forms with uploads")
        Component(rtk, "RTK Query clients", "redux/ baseApi, authApi, publicApi, applicantApi, companyApi, adminApi", "Endpoint hooks, caching, tag invalidation")
        Component(utils, "utils/helpers", "getError, formatDate, dashboardPath, STATUS_OPTIONS", "Shared helpers")
    }

    Rel(user, app, "Navigates")
    Rel(app, layouts, "Renders")
    Rel(app, guard, "Wraps dashboards")
    Rel(layouts, pub, "Outlet")
    Rel(layouts, authp, "Outlet")
    Rel(guard, appd, "role applicant")
    Rel(guard, recd, "role company")
    Rel(guard, admd, "role admin")
    Rel(pub, modals, "ApplyModal")
    Rel(recd, modals, "PostJobModal, EditProfileModal")
    Rel(admd, modals, "AddApplicantModal, AddCompanyModal")
    Rel(guard, rtk, "useGetMeQuery")
    Rel(pub, rtk, "Hooks")
    Rel(authp, rtk, "Hooks")
    Rel(appd, rtk, "Hooks")
    Rel(recd, rtk, "Hooks")
    Rel(admd, rtk, "Hooks")
    Rel(modals, rtk, "Mutations")
    Rel(rtk, api, "fetchBaseQuery", "HTTP/JSON, cookie")
    Rel(pub, utils, "Uses")
    Rel(authp, utils, "Uses")
