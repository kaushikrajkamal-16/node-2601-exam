<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram id="rest-api-layers" name="REST API layers"><mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1536" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style='font-size:20px'&gt;Logical Layers of the REST API - JobPortal BD&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="60" y="8" width="1450" height="28" as="geometry"/></mxCell><mxCell id="c3" value="&lt;span style='font-size:12px;color:#555555'&gt;Node.js + Express 5, base path /api/v1. A request passes down through the layers; the JSON response travels back up the same way.&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="60" y="38" width="1450" height="20" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;HTTP request from the React app - e.g. POST /api/v1/auth/login&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontSize=13;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="530" y="70" width="500" height="40" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#3b6ea5;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="60" y="144" width="1450" height="150" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:12px'&gt;LAYER 1&lt;/b&gt;&lt;br&gt;&lt;b style='font-size:15px'&gt;Entry point and&lt;br&gt;HTTP pipeline&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i style='font-size:11px'&gt;server.js&lt;br&gt;loads config, connects&lt;br&gt;services, adds global&lt;br&gt;middleware&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#3b6ea5;strokeColor=#3b6ea5;fontColor=#ffffff;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="144" width="215" height="150" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b style="font-size:12.5px"&gt;Configuration&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;dotenv: PORT, BASE_URL,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;CLIENT_URL, JWT_SEC,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;MONGO_URI, ...&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#3b6ea5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="285.0" y="173" width="170" height="92" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b style="font-size:12.5px"&gt;CORS&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;origin = CLIENT_URL&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;credentials: true&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#3b6ea5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="459.2" y="173" width="170" height="92" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b style="font-size:12.5px"&gt;express.json()&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;parses JSON request&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;bodies into req.body&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#3b6ea5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="633.3" y="173" width="170" height="92" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b style="font-size:12.5px"&gt;cookie-parser&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;reads cookies into&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;req.cookies (accessToken)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#3b6ea5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="807.5" y="173" width="170" height="92" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b style="font-size:12.5px"&gt;Database connection&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;mongoose.connect&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;(MONGO_URI) at start-up&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#3b6ea5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="981.7" y="173" width="170" height="92" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b style="font-size:12.5px"&gt;Cloudinary config&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;SDK keys from env&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;+ connection ping&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#3b6ea5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1155.8" y="173" width="170" height="92" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b style="font-size:12.5px"&gt;Global error handler&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;registered last;&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;multer / other errors&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;-&amp;gt; HTTP 400 JSON&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#3b6ea5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1330.0" y="173" width="170" height="92" as="geometry"/></mxCell><mxCell id="c14" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#eaf7ea;strokeColor=#3f8f3f;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="60" y="334" width="1450" height="260" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b style='font-size:12px'&gt;LAYER 2&lt;/b&gt;&lt;br&gt;&lt;b style='font-size:15px'&gt;Routing&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i style='font-size:11px'&gt;routes/index.js and&lt;br&gt;routes/api/*.js&lt;br&gt;map URL + method to a&lt;br&gt;handler and attach guards&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#3f8f3f;strokeColor=#3f8f3f;fontColor=#ffffff;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="334" width="215" height="260" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b style="font-size:12.5px"&gt;routes/index.js - router.use(process.env.BASE_URL = /api/v1, apiRoute)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;any unknown path under /api/v1 answers with a JSON 404: { success: false, message: "No Api Found On This Route Location" }&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#3f8f3f;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="285" y="346" width="1215" height="50" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b style='font-size:14px'&gt;/auth&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#555555'&gt;routes/api/auth.js&lt;/i&gt;&lt;br&gt;&lt;br&gt;PUBLIC: register, verifyEmail,&lt;br&gt;resendOtp, login, forgotPassword,&lt;br&gt;resetpassword, logout&lt;br&gt;authMiddleware: getme,&lt;br&gt;updateprofile (+ uploadImage)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#3f8f3f;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="285.0" y="406" width="235.0" height="176" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b style='font-size:14px'&gt;/applicant&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#555555'&gt;routes/api/applicant.js&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;authMiddleware +&lt;/b&gt;&lt;br&gt;&lt;b&gt;roleMiddleware(&quot;applicant&quot;)&lt;/b&gt;&lt;br&gt;POST apply/:jobId (+ uploadResume)&lt;br&gt;GET applications&lt;br&gt;DELETE applications/withdraw/:id" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#3f8f3f;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="530.0" y="406" width="235.0" height="176" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b style='font-size:14px'&gt;/company&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#555555'&gt;routes/api/company.js&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;authMiddleware +&lt;/b&gt;&lt;br&gt;&lt;b&gt;roleMiddleware(&quot;company&quot;)&lt;/b&gt;&lt;br&gt;jobs: GET, create, update,&lt;br&gt;pause, delete&lt;br&gt;candidates: GET, status, delete" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#3f8f3f;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="775.0" y="406" width="235.0" height="176" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b style='font-size:14px'&gt;/admin&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#555555'&gt;routes/api/admin.js&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;authMiddleware +&lt;/b&gt;&lt;br&gt;&lt;b&gt;roleMiddleware(&quot;admin&quot;)&lt;/b&gt;&lt;br&gt;stats, users, applicants,&lt;br&gt;companies, jobs: list, add,&lt;br&gt;flag, close, delete" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#3f8f3f;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020.0" y="406" width="235.0" height="176" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b style='font-size:14px'&gt;/  (public)&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#555555'&gt;routes/api/job.js&lt;/i&gt;&lt;br&gt;&lt;br&gt;no login required&lt;br&gt;GET /jobs&lt;br&gt;GET /jobs/latest&lt;br&gt;GET /jobs/:slug&lt;br&gt;GET /companies" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#3f8f3f;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1265.0" y="406" width="235.0" height="176" as="geometry"/></mxCell><mxCell id="c22" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fdeee3;strokeColor=#c26a1f;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="60" y="634" width="1450" height="156" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b style='font-size:12px'&gt;LAYER 3&lt;/b&gt;&lt;br&gt;&lt;b style='font-size:15px'&gt;Security and request&lt;br&gt;middleware&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i style='font-size:11px'&gt;middleware/&lt;br&gt;who are you, what may&lt;br&gt;you do, what file did&lt;br&gt;you send&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#c26a1f;strokeColor=#c26a1f;fontColor=#ffffff;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="634" width="215" height="156" as="geometry"/></mxCell><mxCell id="c24" value='&lt;b style="font-size:12.5px"&gt;authMiddleware.js&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;reads the accessToken cookie, verifies the JWT&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;loads the user from MongoDB into req.user&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;no cookie / bad token / deleted user -&amp;gt; 401&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#c26a1f;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="285.0" y="657" width="395.7" height="110" as="geometry"/></mxCell><mxCell id="c25" value='&lt;b style="font-size:12.5px"&gt;roleMiddleware.js&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;roleMiddleware(...roles) runs after authMiddleware&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;allows only the listed roles (applicant,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;company, admin) -&amp;gt; otherwise 403&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#c26a1f;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="694.7" y="657" width="395.7" height="110" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b style="font-size:12.5px"&gt;upload.js (multer)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;uploadImage: PNG, JPG, WebP | uploadResume:&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;PDF, DOC, DOCX | max 5 MB, kept in memory&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;(req.file); wrong type / size -&amp;gt; error handler&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#c26a1f;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1104.3" y="657" width="395.7" height="110" as="geometry"/></mxCell><mxCell id="c27" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f3eafb;strokeColor=#7a4fb0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="60" y="830" width="1450" height="186" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b style='font-size:12px'&gt;LAYER 4&lt;/b&gt;&lt;br&gt;&lt;b style='font-size:15px'&gt;Controllers&lt;br&gt;(business logic)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i style='font-size:11px'&gt;controllers/&lt;br&gt;validate input, apply&lt;br&gt;business rules, check&lt;br&gt;ownership, shape the&lt;br&gt;{ success, message }&lt;br&gt;response&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#7a4fb0;strokeColor=#7a4fb0;fontColor=#ffffff;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="830" width="215" height="186" as="geometry"/></mxCell><mxCell id="c29" value='&lt;b style="font-size:12.5px"&gt;authController&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;register + e-mail OTP verify / resend&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;login (JWT cookie) and logout&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;forgot / reset password&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;get and update own profile&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;+ photo upload&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#7a4fb0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="285.0" y="842" width="235.0" height="162" as="geometry"/></mxCell><mxCell id="c30" value='&lt;b style="font-size:12.5px"&gt;applicantController&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;apply: job active? deadline?&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;already applied? upload resume&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;list own applications&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;withdraw (not when approved)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#7a4fb0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="530.0" y="842" width="235.0" height="162" as="geometry"/></mxCell><mxCell id="c31" value='&lt;b style="font-size:12.5px"&gt;companyController&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;create / edit / pause / delete jobs&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;list candidates (own jobs only)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;update status + interview note&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;remove a candidate&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#7a4fb0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="775.0" y="842" width="235.0" height="162" as="geometry"/></mxCell><mxCell id="c32" value='&lt;b style="font-size:12.5px"&gt;adminController&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;statistics and recent users&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;manage applicants, companies, jobs&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;flag applicant, close job&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;cascade deletes (applications,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;resume files)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#7a4fb0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1020.0" y="842" width="235.0" height="162" as="geometry"/></mxCell><mxCell id="c33" value='&lt;b style="font-size:12.5px"&gt;jobController&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;public job list (active only)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;latest jobs, job by slug&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;public company list&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;with open-job counts&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#7a4fb0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1265.0" y="842" width="235.0" height="162" as="geometry"/></mxCell><mxCell id="c34" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff6dc;strokeColor=#b8902a;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="60" y="1072" width="1450" height="150" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b style='font-size:12px'&gt;LAYER 5&lt;/b&gt;&lt;br&gt;&lt;b style='font-size:15px'&gt;Utilities and&lt;br&gt;data access&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i style='font-size:11px'&gt;utils/ and model/&lt;br&gt;no separate service or&lt;br&gt;repository layer&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#b8902a;strokeColor=#b8902a;fontColor=#ffffff;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="1072" width="215" height="150" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b style='font-size:12px'&gt;Utility modules (utils/)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fffdf3;strokeColor=#b8902a;dashed=1;verticalAlign=top;align=center;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="285" y="1080" width="586.5" height="134" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b style='font-size:12px'&gt;Mongoose models (model/)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fffdf3;strokeColor=#b8902a;dashed=1;verticalAlign=top;align=center;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="913.5" y="1080" width="586.5" height="134" as="geometry"/></mxCell><mxCell id="c38" value='&lt;b style="font-size:12.5px"&gt;helpers.js&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;generateOTP, JWT signing,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;email / password checks,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;makeSlug, formatJob,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;statusLabel, daysLeft&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#b8902a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="296" y="1106" width="180" height="104" as="geometry"/></mxCell><mxCell id="c39" value='&lt;b style="font-size:12.5px"&gt;mailService.js&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;sendMail() with Nodemailer&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;+ mailTemplate.js&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;(OTP e-mail HTML)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#b8902a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="488" y="1106" width="180" height="104" as="geometry"/></mxCell><mxCell id="c40" value='&lt;b style="font-size:12.5px"&gt;uploadToCloudinary.js&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;uploadToCloudinary()&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;deleteFromCloudinary()&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;(memory buffer -&amp;gt; stream)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#b8902a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="680" y="1106" width="180" height="104" as="geometry"/></mxCell><mxCell id="c41" value='&lt;b style="font-size:12.5px"&gt;User model&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;users collection&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;email unique, role enum,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;bcrypt hash on save,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;ComparePassword()&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#b8902a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="924" y="1106" width="180" height="104" as="geometry"/></mxCell><mxCell id="c42" value='&lt;b style="font-size:12.5px"&gt;Job model&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;jobs collection&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;slug unique,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;status: active, paused,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;closed&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#b8902a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1116" y="1106" width="180" height="104" as="geometry"/></mxCell><mxCell id="c43" value='&lt;b style="font-size:12.5px"&gt;Application model&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;applications collection&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;unique (job, applicant),&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;embedded statusHistory[]&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#b8902a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1308" y="1106" width="180" height="104" as="geometry"/></mxCell><mxCell id="c44" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#777777;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="60" y="1278" width="1450" height="96" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b style='font-size:12px'&gt;EXTERNAL&lt;/b&gt;&lt;br&gt;&lt;b style='font-size:15px'&gt;Systems and&lt;br&gt;persistence&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#777777;strokeColor=#777777;fontColor=#ffffff;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="1278" width="215" height="96" as="geometry"/></mxCell><mxCell id="c46" value='&lt;b style="font-size:12.5px"&gt;Gmail SMTP&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;OTP e-mails (port 587)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#777777;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="488" y="1292" width="180" height="68" as="geometry"/></mxCell><mxCell id="c47" value='&lt;b style="font-size:12.5px"&gt;Cloudinary&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;photos, logos, resumes&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#777777;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="680" y="1292" width="180" height="68" as="geometry"/></mxCell><mxCell id="c48" value='&lt;b style="font-size:12.5px"&gt;MongoDB&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;collections: users, jobs, applications&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;(connection string from MONGO_URI)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=center;spacingTop=4;fontColor=#111111;fillColor=#ffffff;strokeColor=#777777;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="914" y="1292" width="586" height="68" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b style='font-size:13px'&gt;Notes&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;- There is no separate service or repository layer: controllers call the utility modules and the Mongoose models directly, so Layer 5 is drawn as one band.&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;- Authorization is enforced on the server by roleMiddleware on the /applicant, /company and /admin routers. The frontend ProtectedRoute is only a user-experience redirect.&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;- Public routes (all of /auth except getme and updateprofile, and the job / company listing routes) pass through Layers 1 and 2 only and never touch the security middleware.&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;- Layer 1 also holds the global error handler (registered last); multer upload errors reach it and are returned as HTTP 400 JSON.&lt;/span&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#bfb36b;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="60" y="1400" width="1450" height="112" as="geometry"/></mxCell><mxCell id="c50" value="HTTPS request" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.4966;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c51" value="parsed request (req.body, req.cookies) enters the router" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;fontColor=#333333;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c52" value="route-level guards run first: router.use(authMiddleware, roleMiddleware(role))" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;fontColor=#333333;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c53" value="req.user set, role allowed, uploaded file available as req.file" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;fontColor=#333333;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c22" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c54" value="calls helpers, sendMail, upload / delete file" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;fontColor=#333333;exitX=0.357;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c27" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c55" value="Mongoose queries: find, create, save, delete" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;fontColor=#333333;exitX=0.791;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c27" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c56" value="SMTP" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;fontColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c39" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c57" value="HTTPS" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;fontColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c40" target="c47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c58" value="MongoDB driver" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;fontColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c37" target="c48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c59" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2f6aa8;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;fontColor=#333333;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c44" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="1326"/><mxPoint x="30" y="90"/></Array></mxGeometry></mxCell><mxCell id="c60" value="&lt;i style='font-size:12px;color:#2f6aa8'&gt;JSON response { success, message, ... } travels back up the same layers&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;rotation=270;fillColor=none;strokeColor=none;fontColor=#2f6aa8;" vertex="1" parent="1"><mxGeometry x="-284" y="672" width="600" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>