    f_rjobs --> e_cdel
    f_post --> e_ccreate
    f_post --> e_cupd
    f_cand --> e_ccand
    f_cand --> e_cstat
    f_cand --> e_cdelc
    f_adash --> e_stats
    f_adash --> e_users
    f_aapp --> e_aapp
    f_aapp --> e_aadd
    f_aapp --> e_aflag
    f_aapp --> e_adel
    f_acomp --> e_acomp
    f_acomp --> e_acadd
    f_acomp --> e_acdel
    f_ajobs --> e_ajobs
    f_ajobs --> e_aclose
    f_ajobs --> e_ajdel

    subgraph RES["MATCHING RESULT (verified by comparing redux/*.js with routes/api/*.js)"]
        r1["36 backend routes, 36 matched to a frontend hook.<br/>0 unmatched frontend calls.<br/>0 backend endpoints without a frontend caller.<br/>Caveat: UpdateJob accepts a status field, but PostJobModal does not send it.<br/>Prefix check: routes/index.js mounts at process.env.BASE_URL (/api/v1)."]
    end

    classDef pub fill:#f0fdf4,stroke:#15803d,color:#0b1c30;
    classDef any fill:#eef4ff,stroke:#2563eb,color:#0b1c30;
    classDef app fill:#fefce8,stroke:#a16207,color:#0b1c30;
    classDef comp fill:#fdf2f8,stroke:#be185d,color:#0b1c30;
    classDef adm fill:#fef2f2,stroke:#b91c1c,color:#0b1c30;
    class e_reg,e_ver,e_res,e_login,e_forgot,e_rpw,e_jobs,e_latest,e_slug,e_comp pub;
    class e_logout,e_me,e_up any;
    class e_apply,e_apps,e_wd app;
    class e_cjobs,e_ccreate,e_cupd,e_cpause,e_cdel,e_ccand,e_cstat,e_cdelc comp;
