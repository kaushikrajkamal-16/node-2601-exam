---
title: "API Interaction Map - frontend hooks to backend endpoints (paths relative to /api/v1 = BASE_URL, which VITE_API_URL targets)"
---
flowchart LR
    subgraph RES["MATCHING RESULT - verified by comparing redux/*.js with routes/api/*.js"]
        r1["36 backend routes, 36 matched to a frontend hook.<br/>0 unmatched frontend calls. 0 endpoints without a frontend caller.<br/>Caveat: UpdateJob accepts a status field, but PostJobModal does not send it.<br/>Prefix: routes/index.js mounts the API at process.env.BASE_URL (/api/v1).<br/>Error responses per endpoint: see the sequence-*.puml diagrams."]
    end

    subgraph ADM["ADMIN ONLY - authMiddleware + roleMiddleware('admin')"]
        direction LR
        f_adash["AdminDashboard<br/>useGetStatsQuery, useGetUsersQuery"]
        f_aapp["ManageApplicants + AddApplicantModal<br/>useGetApplicantsQuery, useAddApplicantMutation,<br/>useToggleFlagApplicantMutation, useDeleteApplicantMutation"]
        f_acomp["ManageCompanies + AddCompanyModal<br/>useGetAdminCompaniesQuery, useAddCompanyMutation,<br/>useDeleteCompanyMutation"]
        f_ajobs["ManageJobPosts<br/>useGetAdminJobsQuery, useCloseJobMutation,<br/>useAdminDeleteJobMutation"]
        e_stats["GET /admin/stats<br/>adminController.GetStats<br/>User, Job, Application counts"]
        e_users["GET /admin/users?page&limit&role<br/>adminController.GetUsers<br/>User"]
        e_aapp["GET /admin/applicants?search&page&limit<br/>adminController.GetApplicants<br/>User"]
        e_aadd["POST /admin/applicants/add<br/>adminController.AddApplicant<br/>User (create, verified)"]
        e_aflag["PATCH /admin/applicants/flag/:id<br/>adminController.ToggleFlagApplicant<br/>User.isFlagged"]
        e_adel["DELETE /admin/applicants/delete/:id<br/>adminController.DeleteApplicant<br/>User, Application + Cloudinary"]
        e_acomp["GET /admin/companies?search&industry&page&limit<br/>adminController.GetCompanies<br/>User, Job counts"]
        e_acadd["POST /admin/companies/add<br/>adminController.AddCompany<br/>User (create, verified)"]
        e_acdel["DELETE /admin/companies/delete/:id<br/>adminController.DeleteCompany<br/>User, Job, Application + Cloudinary"]
        e_ajobs["GET /admin/jobs?status&page&limit<br/>adminController.GetAllJobs<br/>Job, User"]
        e_aclose["PATCH /admin/jobs/close/:id<br/>adminController.CloseJob<br/>Job.status, moderatedBy"]
        e_ajdel["DELETE /admin/jobs/delete/:id<br/>adminController.DeleteJob<br/>Job, Application + Cloudinary"]
        f_adash --> e_stats
        f_adash --> e_users
        f_aapp --> e_aapp
        f_aapp --> e_aadd
        f_aapp --> e_aflag
        f_aapp --> e_adel
        f_acomp --> e_acomp
        f_acomp --> e_acadd
        f_acomp --> e_acdel
        f_ajobs --> e_ajobs
        f_ajobs --> e_aclose
        f_ajobs --> e_ajdel
    end

    subgraph COMP["COMPANY ONLY - authMiddleware + roleMiddleware('company')"]
        direction LR
        f_rjobs["RecruiterDashboard<br/>useGetMyJobsQuery, useTogglePauseJobMutation,<br/>useDeleteJobMutation"]
        f_post["PostJobModal.jsx<br/>useCreateJobMutation, useUpdateJobMutation"]
        f_cand["RecruiterDashboard<br/>useGetCandidatesQuery, useUpdateCandidateStatusMutation,<br/>useDeleteCandidateMutation"]
        e_cjobs["GET /company/jobs<br/>companyController.GetMyJobs<br/>Job, Application counts"]
        e_ccreate["POST /company/jobs/create<br/>companyController.CreateJob<br/>Job (create)"]
        e_cupd["PUT /company/jobs/update/:id<br/>companyController.UpdateJob<br/>Job"]
        e_cpause["PATCH /company/jobs/pause/:id<br/>companyController.TogglePauseJob<br/>Job"]
        e_cdel["DELETE /company/jobs/delete/:id<br/>companyController.DeleteJob<br/>Job, Application + Cloudinary"]
        e_ccand["GET /company/candidates?job<br/>companyController.GetCandidates<br/>Application, User, Job"]
        e_cstat["PATCH /company/candidates/status/:id<br/>companyController.UpdateApplicationStatus<br/>Application"]
        e_cdelc["DELETE /company/candidates/delete/:id<br/>companyController.DeleteCandidate<br/>Application + Cloudinary"]
        f_rjobs --> e_cjobs
        f_rjobs --> e_cpause
        f_rjobs --> e_cdel
        f_post --> e_ccreate
        f_post --> e_cupd
        f_cand --> e_ccand
        f_cand --> e_cstat
        f_cand --> e_cdelc
    end

    subgraph APPL["APPLICANT ONLY - authMiddleware + roleMiddleware('applicant')"]
        direction LR
        f_apply["ApplyModal.jsx<br/>useApplyJobMutation"]
        f_myapps["ApplicantDashboard, ApplicantApplication, JobsDetails<br/>useGetMyApplicationsQuery"]
        f_wd["ApplicantApplication.jsx<br/>useWithdrawApplicationMutation"]
        e_apply["POST /applicant/apply/:jobId<br/>multipart, field resume<br/>applicantController.ApplyJob<br/>Job, Application + Cloudinary"]
        e_apps["GET /applicant/applications<br/>applicantController.GetMyApplications<br/>Application, Job, User"]
        e_wd["DELETE /applicant/applications/withdraw/:id<br/>applicantController.WithdrawApplication<br/>Application + Cloudinary"]
        f_apply --> e_apply
        f_myapps --> e_apps
        f_wd --> e_wd
    end

    subgraph AUTH["ANY LOGGED-IN ROLE - authMiddleware"]
        direction LR
        f_me["ProtectedRoute, Navbar, Sidebar, dashboards, JobsDetails<br/>useGetMeQuery"]
        f_logout["Navbar, Sidebar<br/>useLogoutMutation"]
        f_prof["EditProfileModal, RecruiterDashboard<br/>useUpdateProfileMutation"]
        e_logout["POST /auth/logout<br/>authController.Logout<br/>clears cookie"]
        e_me["GET /auth/getme<br/>authController.GetMe<br/>User"]
        e_up["PUT /auth/updateprofile<br/>multipart, field photo<br/>authController.UpdateProfile<br/>User + Cloudinary"]
        f_me --> e_me
        f_logout --> e_logout
        f_prof --> e_up
    end

