@startuml sequence-password-reset
title Forgot / Reset Password (three client steps, three endpoints)
autonumber
skinparam shadowing false
skinparam sequenceMessageAlign left

actor "Visitor" as U
participant "ForgotPassword.jsx\nVerifyOtp.jsx\nResetPassword.jsx\n(authApi)" as FE
participant "authController" as AC
database "MongoDB\nusers" as DB
participant "mailService" as M
participant "Gmail SMTP" as SMTP

== 1. POST /api/v1/auth/forgotPassword ==
U -> FE : enter e-mail
FE -> AC : POST /auth/forgotPassword {email}
alt email empty or invalid
  AC --> FE : 400
else
  AC -> DB : User.findOne({email})
  alt not found
    AC --> FE : 404 "No account found with this email."
  else found
    AC -> DB : resetotp = generateOTP(); otpPurpose = "reset"; resetotpExpiry = now + 10 min; save()
    AC -> M : sendMail({subject:"Reset Password OTP"})
    M -> SMTP : SMTP send
    AC --> FE : 200 {email}
    FE -> FE : navigate("/verifyOtp", {email, from:"forgot"})
  end
end

== 2. POST /api/v1/auth/verifyEmail (from = "forgot") ==
U -> FE : enter code
FE -> AC : POST /auth/verifyEmail {email, otp, from:"forgot"}
AC -> DB : User.findOne({email})
alt user missing
  AC --> FE : 404
else resetotp missing / differs / otpPurpose != "reset"
  AC --> FE : 400 "Wrong OTP..."
else resetotpExpiry < now
  AC --> FE : 400 "OTP has expired..."
else ok
  AC --> FE : 200 "Code is correct. Set your new password."\n(code is NOT consumed)
  FE -> FE : navigate("/resetPassword", {email, otp})
end

== 3. POST /api/v1/auth/resetpassword ==
U -> FE : enter new password (+ confirm)
FE -> AC : POST /auth/resetpassword {email, otp, password, confirmPassword}
alt missing field / confirm mismatch / length < 8 / not strong
  AC --> FE : 400
else
  AC -> DB : User.findOne({email})
  alt user missing
    AC --> FE : 404
  else otp invalid or purpose != "reset"
    AC --> FE : 400 "Wrong code. Please start Forgot Password again."
  else expired
    AC --> FE : 400 "Code has expired..."
  else valid
    AC -> DB : user.password = new; isVerified = true;\nclear resetotp, expiry, otpPurpose; save()  (bcrypt via pre-save)
    AC --> FE : 200 "Password changed successfully. Please log in."
    FE -> FE : navigate("/login")
  end
end
note over AC
  Resend during this flow: POST /auth/resendOtp {from:"forgot"}.
  Backend does not limit OTP attempts (see implementation-gaps.md).
end note
@enduml
