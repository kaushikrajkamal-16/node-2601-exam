C4Component
    title Component Diagram - REST API container (backend, C4 level 3)

    Container(spa, "Single-Page Application", "React", "Calls the API")
    ContainerDb(db, "MongoDB", "MongoDB", "users, jobs, applications")
    System_Ext(cloudinary, "Cloudinary", "Media storage")
    System_Ext(smtp, "Gmail SMTP", "OTP mail")

    Container_Boundary(api, "REST API (Server/)") {
        Component(entry, "server.js", "Express app", "CORS, JSON body, cookie-parser, DB connect, mounts router, error handler")
        Component(routes, "Routers (routes/api)", "express.Router", "auth, applicant, company, admin, job. Mounted at BASE_URL (/api/v1)")
        Component(authmw, "authMiddleware", "JWT verify", "Reads accessToken cookie, loads User into req.user")
        Component(rolemw, "roleMiddleware", "Role check", "Allows only listed roles, else 403")
        Component(uploadmw, "upload middleware", "multer memoryStorage", "uploadImage (png/jpeg/webp) and uploadResume (pdf/doc/docx), 5 MB limit")
        Component(authc, "authController", "Controller", "Registration, VerifyEmail, login, Logout, ResendOtp, ForgotPassword, ResetPassword, GetMe, UpdateProfile")
        Component(appc, "applicantController", "Controller", "ApplyJob, GetMyApplications, WithdrawApplication")
        Component(compc, "companyController", "Controller", "Job CRUD, TogglePauseJob, GetCandidates, UpdateApplicationStatus, DeleteCandidate")
        Component(adminc, "adminController", "Controller", "Stats, users, applicants, companies, job moderation")
        Component(jobc, "jobController", "Controller", "Public GetJobs, GetLatestJobs, GetJobBySlug, GetCompanies")
        Component(helpers, "utils/helpers", "Module", "OTP, JWT signing, slug, validation, formatJob, statusLabel")
        Component(mail, "utils/mail", "Nodemailer", "sendMail + OTP HTML template")
        Component(store, "utils/uploadToCloudinary", "Cloudinary SDK wrapper", "uploadToCloudinary, deleteFromCloudinary")
        Component(models, "Mongoose models", "model/User, Job, Application", "Schemas, indexes, password hash hook, ComparePassword")
    }

    Rel(spa, entry, "HTTP requests", "JSON / multipart")
    Rel(entry, routes, "Delegates by path")
    Rel(routes, authmw, "Protected routes")
    Rel(routes, rolemw, "Role-restricted routes")
    Rel(routes, uploadmw, "File routes")
    Rel(routes, authc, "Dispatches")
    Rel(routes, appc, "Dispatches")
    Rel(routes, compc, "Dispatches")
    Rel(routes, adminc, "Dispatches")
    Rel(routes, jobc, "Dispatches")
    Rel(authmw, models, "findById(User)")
    Rel(authc, models, "Reads/writes User")
    Rel(appc, models, "Reads/writes Job, Application")
    Rel(compc, models, "Reads/writes Job, Application")
    Rel(adminc, models, "Reads/writes all three")
    Rel(jobc, models, "Reads Job, User")
    Rel(authc, helpers, "Uses")
    Rel(compc, helpers, "Uses")
    Rel(adminc, helpers, "Uses")
    Rel(jobc, helpers, "Uses")
    Rel(appc, helpers, "Uses")
    Rel(authc, mail, "Sends OTP")
    Rel(authc, store, "Photo upload/delete")
    Rel(appc, store, "Resume upload/delete")
    Rel(compc, store, "Resume delete")
    Rel(adminc, store, "Resume/photo delete")
    Rel(models, db, "CRUD", "Mongoose")
    Rel(mail, smtp, "SMTP")
    Rel(store, cloudinary, "HTTPS")
