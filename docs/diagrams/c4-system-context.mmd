---
title: "C4 Level 1 - System Context: JobPortal BD"
---
flowchart TB
    visitor(["<b>Visitor</b><br/>[Person]<br/>Unauthenticated user. Browses jobs and companies,<br/>registers, logs in, resets a password"])
    applicant(["<b>Applicant</b><br/>[Person]<br/>Registered job seeker. Applies with a resume,<br/>tracks and withdraws applications, edits profile"])
    company(["<b>Company (Recruiter)</b><br/>[Person]<br/>Registered employer. Posts and manages jobs,<br/>reviews candidates, updates their status"])
    admin(["<b>Admin</b><br/>[Person]<br/>Platform administrator created by the seed script.<br/>Moderates users, companies and job posts"])

    subgraph boundary["System boundary"]
        portal["<b>JobPortal BD Web Application</b><br/>[Software System]<br/>React SPA + Node.js/Express REST API + MongoDB.<br/>Connects applicants with companies"]
    end

    smtp["<b>Gmail SMTP</b><br/>[External System]<br/>Delivers OTP e-mails<br/>(verification and password reset)"]
    cloud["<b>Cloudinary</b><br/>[External System]<br/>Stores profile photos, company logos<br/>and applicant resumes"]

    visitor -- "Browses jobs, registers, logs in<br/>[HTTPS]" --> portal
    applicant -- "Applies to jobs, tracks applications<br/>[HTTPS]" --> portal
    company -- "Posts jobs, reviews candidates<br/>[HTTPS]" --> portal
    admin -- "Manages applicants, companies, jobs<br/>[HTTPS]" --> portal
    portal -- "Sends OTP e-mails<br/>[SMTP 587]" --> smtp
    portal -- "Uploads and deletes files<br/>[HTTPS]" --> cloud

    classDef person fill:#08427b,stroke:#052e56,color:#fff;
    classDef system fill:#1168bd,stroke:#0b4884,color:#fff;
    classDef ext fill:#999,stroke:#6b6b6b,color:#fff;
    class visitor,applicant,company,admin person;
    class portal system;
    class smtp,cloud ext;
