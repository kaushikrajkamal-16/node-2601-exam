C4Context
    title System Context - JobPortal BD (C4 level 1)

    Person(visitor, "Visitor", "Unauthenticated user. Browses jobs and companies, registers, logs in, resets a password.")
    Person(applicant, "Applicant", "Registered job seeker. Applies to jobs with a resume, tracks and withdraws applications, edits own profile.")
    Person(company, "Company (Recruiter)", "Registered employer. Posts and manages jobs, reviews candidates and updates their status.")
    Person(admin, "Admin", "Platform administrator, created by the seed script (npm run seed). Moderates users and jobs.")

    System_Boundary(sysb, "JobPortal BD") {
        System(portal, "JobPortal BD Web Application", "React SPA plus Node.js/Express REST API and MongoDB. Connects applicants with companies.")
    }

    System_Ext(smtp, "Gmail SMTP", "Sends OTP e-mails for e-mail verification and password reset (Nodemailer).")
    System_Ext(cloudinary, "Cloudinary", "Stores profile photos, company logos and applicant resumes (PDF/DOC/DOCX).")

    Rel(visitor, portal, "Browses jobs and companies, registers, logs in", "HTTPS")
    Rel(applicant, portal, "Applies to jobs, tracks applications", "HTTPS")
    Rel(company, portal, "Posts jobs, reviews candidates", "HTTPS")
    Rel(admin, portal, "Manages applicants, companies and job posts", "HTTPS")
    Rel(portal, smtp, "Sends OTP e-mails", "SMTP, port 587")
    Rel(portal, cloudinary, "Uploads and deletes files", "HTTPS, Cloudinary SDK")
    Rel(smtp, applicant, "Delivers OTP code", "E-mail")
    Rel(smtp, company, "Delivers OTP code", "E-mail")
